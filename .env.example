# ─────────────────────────────────────────────
# Supabase (proyecto nuevo dedicado a este proyecto)
# ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ACCESS_TOKEN=

# ─────────────────────────────────────────────
# MercadoPago (Pancho debe crear cuenta vendedor)
# Sandbox disponible en: https://www.mercadopago.com.ar/developers
# ─────────────────────────────────────────────
MP_ACCESS_TOKEN=
NEXT_PUBLIC_MP_PUBLIC_KEY=

# ─────────────────────────────────────────────
# Google Calendar (cuenta Google del negocio)
# Configurar en: https://console.cloud.google.com
# ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google-calendar/callback
GOOGLE_CALENDAR_ID=
GOOGLE_REFRESH_TOKEN=

# ─────────────────────────────────────────────
# App
# ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WA_NUMBER=5491100000000

# ─────────────────────────────────────────────
# Tests
# No hace falta configurar nada acá: los tests levantan su propio Supabase
# local (Docker: `npm run db:test:start`) y leen sus claves solos. Nunca
# corren contra la base real. Ver README → "Tests".
# ─────────────────────────────────────────────
