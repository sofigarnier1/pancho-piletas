{
  "name": "cloro-pancho",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "db:test:start": "supabase start",
    "db:test:stop": "supabase stop",
    "db:test:reset": "supabase db reset --local",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:db": "vitest run --config vitest.db.config.mts",
    "test:all": "npm run test:unit && npm run test:db && npm run test:e2e && npm run test:flows && npm run test:coverage",
    "test:flows": "playwright test -c playwright.flows.config.ts",
    "test:visual": "playwright test --project=visual",
    "test:visual:update": "playwright test --project=visual --update-snapshots",
    "test:smoke": "playwright test -c playwright.smoke.config.ts",
    "test:coverage": "node scripts/coverage-matrix.mjs",
    "test:accion-por-accion": "bash scripts/e2e-run.sh",
    "test:accion-por-accion:resume": "node scripts/e2e-reanudar.mjs",
    "test:dashboard": "node scripts/e2e-dashboard.mjs",
    "manual:capturas": "MANUAL_CAPTURAS=1 playwright test -c playwright.manual.config.ts",
    "manual:pdf": "MANUAL_PDF=1 playwright test -c playwright.manual.config.ts",
    "manual:generar": "MANUAL_CAPTURAS=1 MANUAL_PDF=1 playwright test -c playwright.manual.config.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.105.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.8.0",
    "next": "16.3.8",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.75.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "write-excel-file": "^4.1.1",
    "zod": "^4.4.2",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "pg": "^8.23.1",
    "supabase": "^2.119.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
